# ENV
ENVIRONMENT=Development

# PORTS
API_GATEWAY=4000
USER_SERVICE_PORT=4001
ORG_SERVICE_PORT=4002

# URLs
USER_SERVICE_URL=http://localhost:4001

# Databases
USER_SERVICE_DB_URL=mongodb://127.0.0.1:27017/brandverse-user
ORGANIZATION_DB_URL=mongodb://127.0.0.1:27017/brandverse-organization

# Redis (session store, owned by the API gateway)
API_GATEWAY_REDIS_URL=redis://localhost:6379

# Sessions (seconds)
SESSION_TTL=3600
HANDOFF_TOKEN_TTL=30

# Browser origins the gateway trusts. {workspaceId} is substituted per workspace.
APP_ORIGIN=http://localhost:3000
WORKSPACE_ORIGIN_TEMPLATE=http://company.{workspaceId}.localhost:3000
